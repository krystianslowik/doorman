# "bearer" (default) checks DOORMAN_API_KEY itself, for local runs. The Worker sets "edge"
# for the production container, which trusts the Worker's own key check.
# DOORMAN_AUTH=bearer

# Comma-separated list of accepted bearer tokens (one per client, so each can be rotated independently).
# Generate one with: openssl rand -hex 32
DOORMAN_API_KEY=replace_me
MAX_BATCH_SIZE=100
PORT=3851
